    "overlap_comm": false,
    "contiguous_gradients": true,
    "reduce_scatter": true,
    "allgather_partitions": true
  },
  "fp16": {
    "enabled": "auto"
  },
  "bf16": {
    "enabled": "auto"
  },
  "steps_per_print": 1000,
  "wall_clock_breakdown": false
}
